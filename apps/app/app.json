{
  "expo": {
    "name": "AIGO",
    "slug": "aigo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jcmaker.aigo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jcmaker.aigo",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "aigo",
    "plugins": [
      "expo-router",
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      "expo-video",
      "expo-notifications",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsMovieWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "video/*"
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "사고 현장 사진에 촬영 위치를 함께 저장하기 위해 위치를 사용합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "사고 현장 사진을 찍기 위해 카메라를 사용합니다.",
          "microphonePermission": false,
          "photosPermission": "영상을 선택하기 위해 사진 보관함에 접근합니다."
        }
      ]
    ]
  }
}
